aws_region  = "us-east-1"
name_prefix = "devops-audit"

vpc_id                  = "vpc-0123456789abcdef0"
private_subnet_ids      = ["subnet-aaa", "subnet-bbb"] # with a NAT route
private_route_table_ids = ["rtb-aaa", "rtb-bbb"]       # optional: free S3 gateway endpoint

gateway_url               = "http://litellm.internal:4000/v1"
gateway_security_group_id = "sg-0gateway" # optional: opens the gateway to the Lambdas
gateway_port              = 4000

entra_tenant_id = "00000000-0000-0000-0000-000000000000"
entra_client_id = "11111111-1111-1111-1111-111111111111"
allowed_cidrs   = ["203.0.113.0/24"] # office / VPN egress; [] = no WAF

github_org             = "forbesadvisor"
github_app_id          = "123456"
github_installation_id = "78901234"

security_audit_role_arn = "arn:aws:iam::222222222222:role/devops-audit-guardduty-read" # or null

alarm_email = "platform-devops@example.com"
