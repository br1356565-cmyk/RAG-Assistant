# Demo in a fresh personal AWS account, with your own GitHub repos and a personal Entra
# tenant. Copy to demo.tfvars (git-ignored) and fill in the <...> values.
# Steps: local/DEPLOY-DEMO.md. Expected cost: ~$25-40/month (AgentCore is billed per use);
# destroy after the demo.

aws_region  = "ap-southeast-2"
name_prefix = "audit-demo"

# Network: create everything, with a small NAT instance instead of a NAT gateway.
create_vpc        = true
nat_mode          = "instance"
nat_instance_type = "t4g.micro" # Free plan: only free-tier-eligible instance types

# Models: Bedrock directly (no LiteLLM gateway in this account). Inference-profile ids that
# match aws_region. If Anthropic models are denied on the account (AccessDeniedException),
# Amazon Nova works for both: apac.amazon.nova-pro-v1:0 in ap-southeast-2.
# With Claude: Sonnet for chat, Haiku for batch (Sonnet 5.5 rejects forced tool use).
llm_backend = "bedrock"
chat_model  = "apac.amazon.nova-pro-v1:0"
batch_model = "apac.amazon.nova-pro-v1:0"
# Claude 5.x rejects any non-default temperature, so send none.
chat_temperature  = "none"
batch_temperature = "none"

# Small and disposable.
db_instance_class        = "db.t3.micro"
db_backup_retention_days = 1 # Free plan maximum
db_deletion_protection   = false
db_skip_final_snapshot   = true
secret_recovery_days     = 0
force_destroy_buckets    = true
log_retention_days       = 7
raw_retention_days       = 30

# New accounts often have a Lambda concurrency limit of 10, which leaves no room to reserve.
chat_reserved_concurrency   = -1
investigate_max_concurrency = 2
max_investigations_per_run  = 20

# Identity: your own Entra tenant (see DEPLOY-DEMO.md, step 2).
entra_tenant_id = "<tenant id>"
entra_client_id = "<application (client) id>"
allowed_cidrs   = [] # no WAF ($6/month); the app still requires an Entra login
team_group_ids = {
  web      = "<object id of group 'audit-web'>"
  data     = "<object id of group 'audit-data'>"
  platform = "<object id of group 'audit-platform'>"
}

# GitHub: an App installed on your personal account.
github_org             = "<your GitHub username>"
github_owner_type      = "user"
github_app_id          = "<app id>"
github_installation_id = "<installation id>"
ownership_config       = "ownership.demo.yml"

# GuardDuty is optional: enable it in the console first (trial on the paid plan only), generate sample
# findings, then add "guardduty" here.
collectors        = ["ownership", "dependabot"]
guardduty_regions = ["ap-southeast-2"]

# Agent quality: answers under 70% confidence go back for evidence up to twice; weekly
# investigations still under it wait (up to 72 h) for a team lead in the Review panel.
confidence_threshold      = 0.7
max_confidence_retries    = 2
verify_answers            = true
review_gate_timeout_hours = 72

# AgentCore (DEPLOY-DEMO.md step 6b). false = the all-Lambda design.
agentcore_enabled          = true
agentcore_policy_mode      = "ENFORCE"
agentcore_memory_long_term = false # extraction uses an AgentCore-managed model
agentcore_tracing          = false # needs CloudWatch Transaction Search turned on first

# Fix agent: a second GitHub App with write access, used only for approved fix PRs.
fix_agent_enabled          = true
fix_github_app_id          = null # the fix-bot App ID, as a string
fix_github_installation_id = null # its installation ID, as a string

# Server diagnostics through SSM (read-only checks), with a small demo instance.
diagnostics_enabled       = false
diagnostics_demo_instance = false
diagnostics_demo_team     = "web"

# AWS read tools for chat (team = the resource's `team` tag). Logs Insights is billed per GB
# scanned (cents here); Config and Security Hub bill per recorded change / check and may not
# be allowed on a Free-plan account, so they stay off until you choose to try them.
aws_logs_tool_enabled   = true
logs_tool_max_hours     = 24
aws_config_tool_enabled = false # needs a Config recorder (enable_config_recorder, or the account's own)
enable_config_recorder  = false
enable_securityhub      = false # then add "securityhub" to collectors
demo_aws_resources      = true  # /demo/storefront log group (team web) + an unversioned bucket (team data)

# Spend guard.
alarm_email        = "<your email>"
monthly_budget_usd = 30
