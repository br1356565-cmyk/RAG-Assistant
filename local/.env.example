# Copy to local/.env and fill in. Never commit local/.env.

# Postgres from docker-compose.yml (trust auth, localhost only)
AUDIT_DB_ADMIN_DSN=postgresql://postgres@127.0.0.1:5433/audit
AUDIT_DB_APP_DSN=postgresql://audit_app_login@127.0.0.1:5433/audit
AUDIT_DB_INGEST_DSN=postgresql://audit_ingest_login@127.0.0.1:5433/audit

# Model backend: "gateway" (LiteLLM) or "bedrock" (Converse with your AWS_PROFILE;
# then CHAT_MODEL/BATCH_MODEL are Bedrock inference-profile ids)
LLM_BACKEND=gateway

# LiteLLM: your existing gateway (over VPN), or the local container (--profile litellm)
GATEWAY_URL=http://127.0.0.1:4000/v1
GATEWAY_API_KEY=sk-local-dev
CHAT_MODEL=audit-chat
BATCH_MODEL=audit-batch
# Temperatures: "none" for models that reject one (e.g. with extended thinking)
CHAT_TEMPERATURE=0.2
BATCH_TEMPERATURE=0

# GitHub: a personal token for the prototype only. Easiest:
#   gh auth refresh -s read:org,security_events && gh auth token
# You must be an org owner or security manager to read org-wide Dependabot alerts.
GITHUB_ORG=forbesadvisor
# "user" for repos under a personal account (then use OWNERSHIP_CONFIG=ownership.demo.yml)
GITHUB_OWNER_TYPE=org
OWNERSHIP_CONFIG=ownership.yml
GITHUB_TOKEN=

# Optional: AWS profile for the GuardDuty collector and for the local LiteLLM container
AWS_PROFILE=
AWS_REGION=us-east-1

# Optional tuning
COLLECTORS=ownership,dependabot
MAX_INVESTIGATIONS=15
DEV_SERVER_PORT=8080
